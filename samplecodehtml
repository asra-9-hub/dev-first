<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My First Webpage</title>
</head>
<body>

    <!-- Main Heading -->
    <h1>Welcome to My Website</h1>
    
    <!-- Subheading -->
    <h2>About This Page</h2>

    <!-- Paragraph with bold and italic text -->
    <p>This is a sample paragraph of text. HTML allows you to make text <strong>bold</strong> or <em>italicized</em> very easily.</p>

    <!-- Hyperlink to an external site -->
    <p>Learn more web development practices on the <a href="https://developer.mozilla.org" target="_blank">MDN Web Docs</a>.</p>

    <!-- Unordered List -->
    <h3>My Favorite Fruits</h3>
    <ul>
        <li>Apples</li>
        <li>Bananas</li>
        <li>Strawberries</li>
    </ul>
